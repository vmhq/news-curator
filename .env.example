# Port the server listens on (host-side for docker-compose)
PORT=8391

# API key for POST /api/publish — change this to a strong random value
# Generate one with: openssl rand -hex 32
API_KEY=change-me-to-a-strong-random-key

# Absolute path to curations directory (overridden in docker-compose)
# CURATIONS_DIR=/data/curations

# Public URL of the site — used for canonical URLs and OG tags
# SITE_URL=https://example.com

# Trusted reverse-proxy IPs for rate limiting (comma-separated)
# Set this to your Nginx/Caddy/Traefik container IP so x-forwarded-for is
# trusted only from that proxy, not from arbitrary clients.
# Example: TRUSTED_PROXY_IP=127.0.0.1,::1
# TRUSTED_PROXY_IP=
